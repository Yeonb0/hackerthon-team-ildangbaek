# 이 파일을 복사해 .env로 만들고 실제 값을 채워 사용합니다.
# .env는 git에 커밋되지 않습니다.

# 백엔드 API 서버 주소
# ⚠️ '/api/v1'까지 포함해서 적습니다. api/*.ts의 모든 호출이 이 전제로 상대경로만 씁니다.
#    예) EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080/api/v1
#    (실기기에서는 localhost가 아니라 PC의 LAN IP를 써야 합니다)
EXPO_PUBLIC_API_BASE_URL=

# true면 api/mock 데이터를 사용합니다 (백엔드 대기 중 프론트 단독 진행용, Phase 1 참고)
EXPO_PUBLIC_USE_MOCK=true

# ⚠️ 임시 — 카카오/구글 OAuth SDK가 붙기 전까지만 사용 (백엔드 ADR 0006 · 0017)
#
# POST /auth/login에 보낼 OAuth 토큰 자리의 값입니다. 비워두면 'MOCK_OAUTH_TOKEN'을 씁니다.
# 백엔드는 이 값을 검증하지 않지만 `{provider}-{이 값}`으로 계정을 식별하므로,
# **이 값을 바꾸면 새 계정이 생깁니다** — 온보딩을 처음부터 테스트할 때 쓰세요.
# (로그아웃만으로는 같은 계정에 다시 붙습니다.)
# 예) EXPO_PUBLIC_DEV_OAUTH_TOKEN=test-02
EXPO_PUBLIC_DEV_OAUTH_TOKEN=

# ⚠️ 백엔드는 이제 X-User-Id 헤더를 읽지 않습니다(ADR 0017 — Authorization 토큰으로 통합).
# 기존 EXPO_PUBLIC_DEV_USER_ID는 제거했습니다. .env에 남아 있어도 무시됩니다.
